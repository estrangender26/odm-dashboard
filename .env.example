# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db)

# ── Supabase Storage (server-only; never prefix secrets with VITE_) ──
SUPABASE_URL=                         # Project API URL (https://<project-ref>.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=            # Server-only service-role key
SUPABASE_STORAGE_URL=                 # Direct Storage URL (https://<project-ref>.storage.supabase.co)
SUPABASE_STORAGE_UPLOADS_ENABLED=false
SUPABASE_STORAGE_OM_ENABLED=false
SUPABASE_STORAGE_GOVERNANCE_ENABLED=false
SUPABASE_STORAGE_SMP_ENABLED=false

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_MONTHLY_KPI_UI_ACCEPTANCE_MODE=false # Dev-only Presentation Center acceptance fixtures

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
# ── Backend (AI) ───────────────────────────────────────────────
GROQ_API_KEY=              # Groq API key for ODM Dashboard AI chat
GROQ_MODEL=                # Optional Groq chat model override (defaults to llama-3.3-70b-versatile)
WEB_SEARCH_PROVIDER=tavily # Optional: tavily, serper, or brave (defaults to tavily)
WEB_SEARCH_API_KEY=        # Server-only web search key for the selected provider
TAVILY_API_KEY=            # Optional provider-specific fallback when WEB_SEARCH_PROVIDER=tavily
SERPER_API_KEY=            # Optional provider-specific fallback when WEB_SEARCH_PROVIDER=serper
BRAVE_SEARCH_API_KEY=      # Optional provider-specific fallback when WEB_SEARCH_PROVIDER=brave
