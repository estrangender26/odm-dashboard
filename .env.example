# ───────────────────────────────────────────────────────────────
# ODM Dashboard Environment Variables
# 
# SECURITY WARNING: Never commit real credentials to version control.
# This file contains placeholders only. Copy to .env and fill in real values.
# ───────────────────────────────────────────────────────────────

# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Application secret for JWT/session signing (min 32 characters)

# ── Database ───────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=             # Example: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# ── Supabase Storage (server-only) ─────────────────────────────
# WARNING: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=             # Example: https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Service role key (keep secret)
SUPABASE_STORAGE_URL=                 # Example: https://[PROJECT-REF].storage.supabase.co
SUPABASE_STORAGE_UPLOADS_ENABLED=false
SUPABASE_STORAGE_OM_ENABLED=false
SUPABASE_STORAGE_GOVERNANCE_ENABLED=false
SUPABASE_STORAGE_SMP_ENABLED=false
SUPABASE_STORAGE_PROJECTS_WITHOUT_PPP_ENABLED=false

# ── Frontend (Vite-prefixed vars exposed to browser) ───────────
VITE_MONTHLY_KPI_UI_ACCEPTANCE_MODE=false

# ── Backend (Auth — Google OAuth, OWNER/admin only) ────────────
# OWNER/admin sign-in happens at /login (reached via the hidden 5-click logo
# gesture). The public Projects without PPP workflow needs NO auth config.
GOOGLE_OAUTH_CLIENT_ID=       # Google OAuth client ID (server-side)
GOOGLE_OAUTH_CLIENT_SECRET=   # Google OAuth client secret (server-only secret)
# Canonical public origin used for the OAuth redirect URI (e.g.
# https://odm-dashboard.onrender.com). Optional: when unset, production
# derives it safely from trusted Render proxy headers (X-Forwarded-Proto +
# edge-validated Host); set it to fully pin the public origin.
PUBLIC_APP_URL=               # Optional: canonical public app URL
# One-time OWNER bootstrap (required before the first OWNER login): the
# VERIFIED Google email of the OWNER. On first login the existing legacy
# role=admin row is reconciled in place with the Google identity; email is
# NOT the ongoing authorization boundary.
OWNER_GOOGLE_EMAIL=           # Verified Google email of the OWNER (bootstrap)
# Optional hardening AFTER bootstrap: the immutable Google `sub` of the OWNER.
# Not required before first login. When set, it is the sole first-login
# authority (email bootstrap is disabled while set) and must match the
# persisted OWNER identity or login fails closed.
OWNER_GOOGLE_SUB=             # Optional: immutable Google sub of the OWNER

# ── Backend (AI) ────────────────────────────────────────────────
# Ollama conversational AI provider
# Local: OLLAMA_BASE_URL=http://localhost:11434, OLLAMA_API_KEY optional
# Cloud:  OLLAMA_BASE_URL=https://ollama.com, OLLAMA_API_KEY required (Render secret)
AI_PROVIDER=ollama         # Provider identifier (currently only ollama is supported)
OLLAMA_BASE_URL=           # Ollama endpoint URL (e.g., http://localhost:11434 for local dev)
OLLAMA_API_KEY=            # Optional for localhost; required for https://ollama.com
OLLAMA_MODEL=kimi-k2.7-code:cloud  # Optional model override; defaults to kimi-k2.7-code:cloud
OLLAMA_TIMEOUT_MS=120000   # Request timeout in milliseconds
OLLAMA_MAX_TOKENS=1500     # Maximum tokens per response

# ── Optional Web Search ───────────────────────────────────────
WEB_SEARCH_API_KEY=        # Server-only web search API key
